# Copia este archivo como keystore.properties en la carpeta que contiene este repo (o en su raíz, ignorado
# por git) y rellénalo.
# storeFile: ruta al keystore, FUERA del repo. Haz copia de seguridad: sin él no se pueden publicar actualizaciones.
storeFile=/ruta/a/sendwithmirlo.jks
storePassword=
keyAlias=sendwithmirlo
keyPassword=
